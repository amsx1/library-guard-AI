# ---------------------------------------------------------------------------
# LibraryGuard .gitignore
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / typing / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.nox/
.tox/

# Jupyter
.ipynb_checkpoints/

# --- Secrets: NEVER commit -----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secret*
token.txt
.netrc
.git-credentials

# --- Model weights (large; downloaded/generated, not committed) -----------
*.pt
*.pth
*.onnx
*.engine
*.tflite
models/**
!models/README.md

# --- Datasets & footage (never commit raw data or personal footage) -------
data/**
!data/README.md
!data/sample/
data/sample/**
!data/sample/README.md
!data/sample/sample_video.mp4
datasets/
footage/
*.mp4
*.avi
*.mov
*.mkv
*.webm
!data/sample/sample_video.mp4

# --- Generated outputs ----------------------------------------------------
outputs/
runs/
wandb/
logs/
temp/
tmp/
*.log

# Streamlit
.streamlit/secrets.toml

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Docker
.docker/

# Scratch
scratch/
*.bak
*~